<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MedSestriManipulations.Models"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="models:Catheter"
    Color="Transparent"
    x:Class="MedSestriManipulations.CatheterPopup">

    <Border HorizontalOptions="Center" VerticalOptions="Center"
            BackgroundColor="{StaticResource WarmBg}"
            Stroke="{StaticResource WarmDivider}" StrokeThickness="1"
            Padding="20" WidthRequest="320">
        <Border.StrokeShape>
            <shapes:RoundRectangle CornerRadius="7" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource WarmText}" Offset="0,6" Radius="16" Opacity="0.12" />
        </Border.Shadow>
        <VerticalStackLayout Spacing="18">

            <Border Style="{StaticResource WarmCard}" Padding="16">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ClientName}"
                           Style="{StaticResource WarmSectionHeading}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding PhoneNumber}"
                           FontFamily="OpenSansSemibold" FontSize="14"
                           TextColor="{StaticResource WarmAccent700}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                           FontFamily="OpenSansRegular" FontSize="12"
                           TextColor="{StaticResource WarmTextMuted}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Address}"
                           Style="{StaticResource WarmCaption}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0"
                        Text="Премахни"
                        Style="{StaticResource WarmGhostButton}"
                        TextColor="{StaticResource WarmError}"
                        BorderColor="{StaticResource WarmError}"
                        BorderWidth="1"
                        HorizontalOptions="Fill"
                        Clicked="CheckCatheterAppointment"
                        CommandParameter="{Binding .}" />

                <Button Grid.Row="0" Grid.Column="1"
                        Text="Редактирай"
                        Style="{StaticResource WarmSecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="UpdateCatheterAppointment"
                        CommandParameter="{Binding .}" />

                <Button Grid.Row="1" Grid.ColumnSpan="2"
                        Text="Обади се"
                        Style="{StaticResource WarmPrimaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="CallCatheter" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
