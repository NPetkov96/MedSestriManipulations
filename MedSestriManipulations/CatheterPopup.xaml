<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MedSestriManipulations.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="models:Catheter"
    Color="Transparent"
    x:Class="MedSestriManipulations.CatheterPopup">

    <Border HorizontalOptions="Center" VerticalOptions="Center"
            BackgroundColor="White" Stroke="#D4DDE8" StrokeThickness="1"
            StrokeShape="RoundRectangle 20" Padding="20" WidthRequest="320">
        <VerticalStackLayout Spacing="18">

            <!-- Details card -->
            <Border BackgroundColor="#E8F0FF" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ClientName}" FontSize="20" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" TextColor="#1A1A1A" />
                    <Label Text="{Binding PhoneNumber}" FontSize="15"
                           HorizontalTextAlignment="Center" TextColor="#0066CC" FontAttributes="Bold" />
                    <Label Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}" FontSize="13"
                           HorizontalTextAlignment="Center" TextColor="#666666" />
                    <Label Text="{Binding Address}" FontSize="14"
                           HorizontalTextAlignment="Center" TextColor="#666666" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0"
                        Text="Премахни"
                        BackgroundColor="Transparent"
                        TextColor="#C62828"
                        BorderColor="#C62828"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="46"
                        FontSize="14" FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        Clicked="CheckCatheterAppointment"
                        CommandParameter="{Binding .}" />

                <Button Grid.Row="0" Grid.Column="1"
                        Text="Редактирай"
                        BackgroundColor="#E8EEF5"
                        TextColor="#0066CC"
                        BorderColor="#0066CC"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="46"
                        FontSize="14" FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        Clicked="UpdateCatheterAppointment"
                        CommandParameter="{Binding .}" />

                <Button Grid.Row="1" Grid.ColumnSpan="2"
                        Text="Обади се"
                        BackgroundColor="#0066CC"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        FontSize="15" FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        Clicked="CallCatheter" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
