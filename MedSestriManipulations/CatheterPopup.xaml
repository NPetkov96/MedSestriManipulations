<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MedSestriManipulations.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="models:Catheter"
    Color="Transparent"
    x:Class="MedSestriManipulations.CatheterPopup">

    <Border HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White" Stroke="#D0DCEB" StrokeShape="RoundRectangle 20" Padding="20">
        <VerticalStackLayout Spacing="20">
            <Border BackgroundColor="#E0F7FA" Stroke="#C3E7EE" StrokeShape="RoundRectangle 15" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding ClientName}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Black" />
                    <Label Text="{Binding PhoneNumber}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Black" />
                    <Label Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Black" />
                    <Label Text="{Binding Address}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Black" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0"
                        Text="Премахни"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="40"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Clicked="CheckCatheterAppointment"
                        CommandParameter="{Binding .}" />

                <Button Grid.Row="0" Grid.Column="1"
                        Text="Редактирай"
                        BackgroundColor="DarkSeaGreen"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="40"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Clicked="UpdateCatheterAppointment"
                        CommandParameter="{Binding .}" />

                <Button Grid.Row="1" Grid.ColumnSpan="2"
                        Text="Обади се"
                        BackgroundColor="SteelBlue"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Clicked="CallCatheter" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
