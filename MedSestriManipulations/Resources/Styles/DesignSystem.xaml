<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════ COLOR TOKENS ═══════════════ -->
    <Color x:Key="Primary">#0F766E</Color>
    <Color x:Key="PrimaryLight">#F0FDF9</Color>
    <Color x:Key="PageBackground">#F9FAFB</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextMuted">#9CA3AF</Color>
    <Color x:Key="BorderColor">#F3F4F6</Color>
    <Color x:Key="BorderMedium">#E5E7EB</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>
    <Color x:Key="AccentBlueLight">#EFF6FF</Color>
    <Color x:Key="DangerAmber">#92400E</Color>
    <Color x:Key="DangerAmberLight">#FEF3C7</Color>

    <!-- SolidColorBrush equivalents (for Shadow / Brush consumers) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#111827" />

    <!-- ═══════════════ STYLES ═══════════════ -->

    <!-- Card container -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ShadowBrush}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.04" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary page / section label -->
    <Style x:Key="PageLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Secondary / supporting label -->
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- Teal price pill -->
    <Style x:Key="PriceChip" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource CardBackground}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
