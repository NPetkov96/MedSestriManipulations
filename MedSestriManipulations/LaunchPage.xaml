<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedSestriManipulations.LaunchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F7FBFF"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Premium Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FBFDFF" Offset="0.0" />
                <GradientStop Color="#EEF6FD" Offset="0.55" />
                <GradientStop Color="#DCEEFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Ambient Light Blob Top -->
        <Border
            x:Name="TopBlob"
            WidthRequest="340"
            HeightRequest="340"
            BackgroundColor="#CFE8FF"
            Opacity="0.22"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            TranslationX="-120"
            TranslationY="-70"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 170" />

        <!-- Ambient Light Blob Bottom -->
        <Border
            x:Name="BottomBlob"
            WidthRequest="300"
            HeightRequest="300"
            BackgroundColor="#A8D2FF"
            Opacity="0.16"
            HorizontalOptions="End"
            VerticalOptions="End"
            TranslationX="80"
            TranslationY="120"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 150" />

        <!-- Outer Glow -->
        <Border
            x:Name="OuterGlow"
            WidthRequest="320"
            HeightRequest="320"
            BackgroundColor="#FFFFFF"
            Opacity="0"
            Scale="0.6"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            TranslationY="-18"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 160" />

        <!-- Secondary Glow -->
        <Border
            x:Name="SecondaryGlow"
            WidthRequest="260"
            HeightRequest="260"
            BackgroundColor="#E9F5FF"
            Opacity="0"
            Scale="0.5"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            TranslationY="-18"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 130" />

        <!-- Main Glow -->
        <Border
            x:Name="MainGlow"
            WidthRequest="210"
            HeightRequest="210"
            BackgroundColor="#FFFFFF"
            Opacity="0"
            Scale="0.45"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            TranslationY="-18"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 105" />

        <!-- Logo -->
        <Image
            x:Name="LogoMark"
            Source="medsestri_mark.png"
            WidthRequest="240"
            Opacity="0"
            Scale="0.72"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            TranslationY="-12" />

        <!-- Premium Bottom Curves -->
        <Grid
            VerticalOptions="End"
            HeightRequest="260"
            InputTransparent="True">

            <Border
                BackgroundColor="#DCEEFF"
                HeightRequest="220"
                Margin="-60,0,-60,-46"
                Opacity="0.92"
                StrokeThickness="0"
                VerticalOptions="End"
                StrokeShape="RoundRectangle 240,240,0,0" />

            <Border
                BackgroundColor="#BEDDFA"
                HeightRequest="170"
                Margin="-90,0,-30,-36"
                Opacity="0.92"
                StrokeThickness="0"
                VerticalOptions="End"
                StrokeShape="RoundRectangle 240,240,0,0" />

            <Border
                BackgroundColor="#93BFEF"
                HeightRequest="112"
                Margin="-30,0,-110,-24"
                Opacity="0.95"
                StrokeThickness="0"
                VerticalOptions="End"
                StrokeShape="RoundRectangle 240,240,0,0" />
        </Grid>

    </Grid>
</ContentPage>
