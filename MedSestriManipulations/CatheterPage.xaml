<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             BackgroundColor="#F8F9FB"
             x:Class="MedSestriManipulations.CatheterPage">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Row 0: Top Navigation -->
        <controls:TopNavigationMenu Grid.Row="0" />

        <!-- Row 1: Action bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="16,12,16,4"
              BackgroundColor="#F8F9FB">
            <Label Grid.Column="0"
                   Text="Катетри"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="#1A1A1A"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="+ Добави"
                    Clicked="OnOpenAddSheetClicked"
                    BackgroundColor="#0066CC"
                    TextColor="White"
                    CornerRadius="6"
                    Padding="16,8"
                    FontAttributes="Bold"
                    FontSize="13" />
        </Grid>

        <!-- Row 2: Search bar -->
        <Grid Grid.Row="2" Padding="16,4,16,10" BackgroundColor="#F8F9FB">
            <Border Stroke="#D4DDE8" StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 8"
                    Padding="6,0">
                <SearchBar x:Name="SearchBar"
                           Placeholder="Търси по име или телефон..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           FontSize="14" HeightRequest="48"
                           CancelButtonColor="#0066CC"
                           TextColor="#1A1A1A"
                           PlaceholderColor="#999999" />
            </Border>
        </Grid>

        <!-- Row 3: Catheters list -->
        <CollectionView Grid.Row="3"
                        x:Name="CathetersListView"
                        SelectionMode="None"
                        Margin="16,4,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Catheter">
                    <Border Margin="0,5,0,5"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="White"
                            Stroke="#D4DDE8"
                            StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference CathetersListView}, Path=BindingContext.ShowPopupCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF4D6" />
                                <Setter Property="Stroke" Value="#F0C24B" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding ClientName}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="#1A1A1A" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding PhoneNumber}"
                                       FontSize="12" TextColor="#666666" />
                                <Label Text="{Binding Address}"
                                       FontSize="12" TextColor="#999999"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="#E8F0FF"
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="#0066CC" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="32,60" Spacing="10">
                    <Label Text="💧" FontSize="44" HorizontalOptions="Center" Opacity="0.4" />
                    <Label Text="Няма катетри"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#666666" HorizontalOptions="Center" />
                    <Label Text="Добави нов катетър с бутона горе"
                           FontSize="13" TextColor="#AAAAAA"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Add/edit bottom sheet dim overlay -->
        <Grid x:Name="SheetOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#70000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Add/edit bottom sheet -->
        <Border x:Name="SheetPanel"
                Grid.RowSpan="4"
                VerticalOptions="End"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20,20,0,0">
            <VerticalStackLayout Spacing="14" Padding="20,12,20,32">

                <BoxView WidthRequest="40" HeightRequest="4"
                         BackgroundColor="#D4DDE8"
                         HorizontalOptions="Center"
                         CornerRadius="2" />

                <Label x:Name="SheetTitleLabel"
                       Text="Нов катетър"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#1A1A1A" />

                <Border Stroke="#D4DDE8" StrokeThickness="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Entry x:Name="PatientNameEntry"
                               Placeholder="Име на пациента"
                               FontSize="14" BackgroundColor="Transparent"
                               TextColor="#1A1A1A" PlaceholderColor="#999999"
                               HeightRequest="46" Margin="14,0"
                               Focused="OnSheetEntryFocused" Unfocused="OnSheetEntryUnfocused" />
                        <BoxView Color="#F0F3F7" HeightRequest="1" />
                        <Entry x:Name="PhoneEntry"
                               Placeholder="Телефон"
                               Keyboard="Telephone" FontSize="14"
                               BackgroundColor="Transparent" TextColor="#1A1A1A"
                               PlaceholderColor="#999999" HeightRequest="46" Margin="14,0"
                               Focused="OnSheetEntryFocused" Unfocused="OnSheetEntryUnfocused" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="Дата на поставяне"
                           FontSize="13" TextColor="#666666"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1" Stroke="#D4DDE8" StrokeThickness="1"
                            BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10,0">
                        <DatePicker x:Name="CatheterDatePicker" FontSize="14" TextColor="#1A1A1A" />
                    </Border>
                </Grid>

                <Border Stroke="#D4DDE8" StrokeThickness="1"
                        BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10,4">
                    <Editor x:Name="AddressEntry"
                            Placeholder="Адрес"
                            FontSize="14" TextColor="#1A1A1A" PlaceholderColor="#999999"
                            AutoSize="TextChanges" HeightRequest="80"
                            Focused="OnSheetEntryFocused" Unfocused="OnSheetEntryUnfocused" />
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Запиши"
                            Clicked="OnSaveClicked"
                            BackgroundColor="#0066CC"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            FontSize="15" />
                    <Button Grid.Column="1"
                            Text="Изчисти"
                            Clicked="ClearFields"
                            BackgroundColor="#E8EEF5"
                            TextColor="#0066CC"
                            BorderColor="#0066CC"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="50"
                            Padding="20,0"
                            FontAttributes="Bold"
                            FontSize="14" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              BackgroundColor="#80000000"
              IsVisible="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" IsVisible="True"
                                   WidthRequest="55" HeightRequest="55" Color="White" />
                <Label Text="Записване..." TextColor="White" FontSize="14" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
