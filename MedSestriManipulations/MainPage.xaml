<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             BackgroundColor="#dfe9f5"
             x:Class="MedSestriManipulations.MainPage">

    <Grid RowDefinitions="Auto,*">
        <controls:TopNavigationMenu Grid.Row="0" />

        <CollectionView x:Name="ProcedureList"
                        Grid.Row="1"
                        Margin="8,0,8,10"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReached="OnLoadMore">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,8,0,6" Spacing="8">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Button Text="Изпрати" Clicked="OnSendClicked" BackgroundColor="#007BFF" TextColor="White" CornerRadius="20" Padding="40,10" FontAttributes="Bold" />
                        <Button Text="Зачисти" Clicked="OnClearClicked" BackgroundColor="DarkRed" TextColor="White" CornerRadius="20" Padding="40,10" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <Label Text="Данни за пациент:" FontSize="22" />

                    <Border Stroke="#CCCCCC" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="10,5">
                        <Entry x:Name="CurrentName" Placeholder="Име" FontSize="18" BackgroundColor="Transparent" TextColor="#000" HeightRequest="20" />
                    </Border>

                    <Border Stroke="#CCCCCC" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="10,5">
                        <Entry x:Name="EGNEntry" Placeholder="ЕГН" Keyboard="Numeric" FontSize="18" BackgroundColor="Transparent" TextColor="#000" HeightRequest="20" />
                    </Border>

                    <Border Stroke="#CCCCCC" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="10,5">
                        <Entry x:Name="PhoneEntry" Placeholder="Телефон" Keyboard="Telephone" FontSize="18" BackgroundColor="Transparent" TextColor="#000" HeightRequest="20" />
                    </Border>

                    <Border Stroke="#CCCCCC" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="10,5">
                        <Entry x:Name="UIN" Placeholder="Лекар УИН" Keyboard="Numeric" FontSize="18" BackgroundColor="Transparent" TextColor="#000" HeightRequest="20" />
                    </Border>

                    <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 5" BackgroundColor="White" Padding="0" Margin="0,10">
                        <Grid ColumnDefinitions="Auto,*" HeightRequest="50" Padding="10,0">
                            <Label Text="Изследвания:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Grid.Column="0" />

                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="3">
                                <Label x:Name="TotalEURLabel" Text="0.00 €" FontSize="16" FontAttributes="Bold" TextColor="DarkRed" />
                                <Label Text="/" FontSize="18" FontAttributes="Bold" TextColor="#007BFF" />
                                <Label x:Name="TotalBGNLabel" Text="0.00 лв" FontSize="16" FontAttributes="Bold" TextColor="#007BFF" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 15" BackgroundColor="White" Margin="0,0,0,10" Padding="8">
                        <SearchBar x:Name="SearchBar" Placeholder="Търси изследване..." TextChanged="OnSearchTextChanged" BackgroundColor="Transparent" FontSize="16" HeightRequest="45" CancelButtonColor="#007BFF" />
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BloodTest">
                    <Border Margin="0,5" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6">
                            <CheckBox IsChecked="{Binding IsSelected}" CheckedChanged="AddSumWhenBloodTestChecked" Color="#afd5ff" Scale="1.4" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ShowsPopupDetailsBloodTest" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Label Text="{Binding Name}" FontSize="18" TextColor="Black" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding EuroPrice, StringFormat=' {0:F2} euro'}" FontSize="16" TextColor="DarkRed" Margin="0,2,0,0" />
                                    <Label Text="/" FontSize="16" TextColor="Gray" Margin="0,2,0,0" />
                                    <Label Text="{Binding BngPrice, StringFormat=' {0:F2} лв'}" FontSize="16" TextColor="Gray" Margin="0,2,0,0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" IsVisible="True" WidthRequest="60" HeightRequest="60" Color="White" />
                <Label Text="Зареждане на SMS..." TextColor="White" FontSize="16" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
