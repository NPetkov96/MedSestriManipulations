<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             BackgroundColor="{StaticResource WarmBg}"
             x:Class="MedSestriManipulations.MainPage">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <controls:TopNavigationMenu Grid.Row="0" />

        <!-- Consolidated sticky selection / CTA header -->
        <Border Grid.Row="1"
                x:Name="SelectionHeader"
                IsVisible="False"
                BackgroundColor="{StaticResource WarmSurface}"
                Stroke="Transparent"
                Padding="18,9,18,14">
            <Border.Shadow>
                <Shadow Brush="{StaticResource WarmText}" Offset="0,2" Radius="6" Opacity="0.10" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="9">
                <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="Изчисти"
                            Style="{StaticResource WarmGhostButton}"
                            TextColor="{StaticResource WarmError}"
                            FontSize="13"
                            Padding="0"
                            HorizontalOptions="Start"
                            Clicked="OnClearClicked" />
                    <Label Grid.Column="1"
                           x:Name="SelectionSummaryLabel"
                           FontSize="13"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>

                <Button x:Name="ContinueButton"
                        Text="Продължи"
                        Style="{StaticResource WarmPrimaryButton}"
                        FontSize="13"
                        Padding="18,6"
                        HorizontalOptions="Fill"
                        Clicked="OnContinueClicked" />
            </VerticalStackLayout>
        </Border>

        <!-- Sticky search field - always directly above the test list, nothing in between -->
        <Border Grid.Row="2"
                Style="{StaticResource WarmFieldBorder}"
                Margin="18,9,18,9"
                Padding="14,0">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">

                <Grid Grid.Column="0" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                    <shapes:Ellipse WidthRequest="11" HeightRequest="11"
                                    Stroke="{StaticResource WarmNeutral500}"
                                    StrokeThickness="1.5"
                                    HorizontalOptions="Start" VerticalOptions="Start" />
                    <shapes:Line X1="8" Y1="8" X2="15" Y2="15"
                                 Stroke="{StaticResource WarmNeutral500}"
                                 StrokeThickness="1.5" />
                </Grid>

                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Style="{StaticResource WarmEntry}"
                       Placeholder="Търси изследване…"
                       ReturnType="Search"
                       TextChanged="OnSearchTextChanged"
                       VerticalOptions="Center" />

                <Button Grid.Column="2"
                        x:Name="SearchClearButton"
                        Text="×"
                        FontSize="20"
                        Style="{StaticResource WarmGhostButton}"
                        IsVisible="False"
                        Clicked="OnSearchClearClicked"
                        SemanticProperties.Description="Изчисти търсенето" />
            </Grid>
        </Border>

        <controls:SkeletonListView x:Name="SkeletonView"
                                   SkeletonType="BloodTest"
                                   Grid.Row="3"
                                   IsLoading="True" />

        <CollectionView x:Name="ProcedureList"
                        Grid.Row="3"
                        Margin="18,0,18,0"
                        IsVisible="False"
                        ItemsLayout="VerticalList"
                        ItemSizingStrategy="MeasureAllItems"
                        RemainingItemsThreshold="8"
                        RemainingItemsThresholdReached="ProcedureList_RemainingItemsThresholdReached">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BloodTest">
                    <controls:TestRowView>
                        <controls:TestRowView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBloodTestRowTapped" />
                        </controls:TestRowView.GestureRecognizers>
                    </controls:TestRowView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="37,74" Spacing="14">
                    <Grid WidthRequest="40" HeightRequest="40" HorizontalOptions="Center">
                        <shapes:Ellipse WidthRequest="26" HeightRequest="26"
                                        Stroke="{StaticResource WarmNeutral400}"
                                        StrokeThickness="2"
                                        HorizontalOptions="Start" VerticalOptions="Start" />
                        <shapes:Line X1="22" Y1="22" X2="34" Y2="34"
                                     Stroke="{StaticResource WarmNeutral400}"
                                     StrokeThickness="2" />
                    </Grid>
                    <Label Text="Нищо не намерихме"
                           Style="{StaticResource WarmSectionHeading}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Опитайте с друга дума или проверете изписването."
                           Style="{StaticResource WarmCaption}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Изчисти търсенето"
                            Style="{StaticResource WarmSecondaryButton}"
                            Clicked="OnClearSearchClicked" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
