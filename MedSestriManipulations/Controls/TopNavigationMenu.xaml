<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MedSestriManipulations.Controls.TopNavigationMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Loaded="OnLoaded">

    <!-- Flat white header -->
    <Grid BackgroundColor="White" RowDefinitions="Auto,Auto,Auto">

        <!-- Top bar: brand title -->
        <Grid Grid.Row="0" Padding="16,12,16,8">
            <Label
                Text="Медицински Сестри"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <!-- Always-visible segmented tab row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" BackgroundColor="White">

            <!-- Начало tab -->
            <Grid Grid.Column="0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoHome" />
                </Grid.GestureRecognizers>
                <Label x:Name="HomeTabLabel"
                       Text="Начало"
                       FontSize="14"
                       TextColor="#9CA3AF"
                       HorizontalOptions="Center"
                       Padding="0,10,0,12" />
                <BoxView x:Name="HomeUnderline"
                         HeightRequest="2"
                         WidthRequest="44"
                         Color="#0F766E"
                         IsVisible="False"
                         VerticalOptions="End"
                         HorizontalOptions="Center" />
            </Grid>

            <!-- История tab -->
            <Grid Grid.Column="1">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoHistory" />
                </Grid.GestureRecognizers>
                <Label x:Name="HistoryTabLabel"
                       Text="История"
                       FontSize="14"
                       TextColor="#9CA3AF"
                       HorizontalOptions="Center"
                       Padding="0,10,0,12" />
                <BoxView x:Name="HistoryUnderline"
                         HeightRequest="2"
                         WidthRequest="44"
                         Color="#0F766E"
                         IsVisible="False"
                         VerticalOptions="End"
                         HorizontalOptions="Center" />
            </Grid>

            <!-- Катетри tab -->
            <Grid Grid.Column="2">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoCatheters" />
                </Grid.GestureRecognizers>
                <Label x:Name="CathetersTabLabel"
                       Text="Катетри"
                       FontSize="14"
                       TextColor="#9CA3AF"
                       HorizontalOptions="Center"
                       Padding="0,10,0,12" />
                <BoxView x:Name="CathetersUnderline"
                         HeightRequest="2"
                         WidthRequest="44"
                         Color="#0F766E"
                         IsVisible="False"
                         VerticalOptions="End"
                         HorizontalOptions="Center" />
            </Grid>
        </Grid>

        <!-- 1px bottom separator under the entire header -->
        <BoxView Grid.Row="2" HeightRequest="1" Color="#F0F0F0" />
    </Grid>
</ContentView>
