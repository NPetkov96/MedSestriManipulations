<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MedSestriManipulations.Controls.TopNavigationMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Loaded="OnLoaded">

    <Grid BackgroundColor="#F8F9FB" Padding="10,8,10,6">
        <Border
            BackgroundColor="White"
            Stroke="#D4DDE8"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="12,8">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Медицински Сестри"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#1A1A1A"
                        VerticalOptions="Center" />

                    <Button
                        x:Name="MenuButton"
                        Grid.Column="1"
                        Text="Меню"
                        Clicked="ToggleMenu"
                        BackgroundColor="#E8EEF5"
                        TextColor="#0066CC"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Padding="18,8"
                        MinimumHeightRequest="38" />
                </Grid>

                <Border
                    x:Name="NavigationPanel"
                    Grid.Row="1"
                    IsVisible="False"
                    BackgroundColor="#F8F9FB"
                    Stroke="#D4DDE8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="4">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Button
                            x:Name="HomeButton"
                            Text="Начало"
                            Clicked="GoHome"
                            BackgroundColor="Transparent"
                            TextColor="#1A1A1A"
                            CornerRadius="6"
                            Padding="8,8"
                            FontSize="14"
                            MinimumHeightRequest="36" />

                        <Button
                            x:Name="HistoryButton"
                            Grid.Column="1"
                            Text="История"
                            Clicked="GoHistory"
                            BackgroundColor="Transparent"
                            TextColor="#1A1A1A"
                            CornerRadius="6"
                            Padding="8,8"
                            FontSize="14"
                            MinimumHeightRequest="36" />

                        <Button
                            x:Name="CathetersButton"
                            Grid.Column="2"
                            Text="Катетри"
                            Clicked="GoCatheters"
                            BackgroundColor="Transparent"
                            TextColor="#1A1A1A"
                            CornerRadius="6"
                            Padding="8,8"
                            FontSize="14"
                            MinimumHeightRequest="36" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>
