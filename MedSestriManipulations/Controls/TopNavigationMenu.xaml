<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MedSestriManipulations.Controls.TopNavigationMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Loaded="OnLoaded">

    <Grid BackgroundColor="#dfe9f5" Padding="10,8,10,6">
        <Border
            BackgroundColor="White"
            Stroke="#C9D8EA"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            Padding="12,8">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            Text="MedSestri"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#172033" />

                        <Label
                            Text="Навигация"
                            FontSize="11"
                            TextColor="#667085" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="MenuButton"
                        Grid.Column="1"
                        Text="Меню"
                        Clicked="ToggleMenu"
                        BackgroundColor="#EAF3FF"
                        TextColor="#007BFF"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        Padding="18,8"
                        MinimumHeightRequest="38" />
                </Grid>

                <Border
                    x:Name="NavigationPanel"
                    Grid.Row="1"
                    IsVisible="False"
                    BackgroundColor="#F7FAFE"
                    Stroke="#E2ECF7"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="4">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Button
                            x:Name="HomeButton"
                            Text="Начало"
                            Clicked="GoHome"
                            BackgroundColor="Transparent"
                            TextColor="#172033"
                            CornerRadius="12"
                            Padding="8,8"
                            FontSize="14"
                            MinimumHeightRequest="36" />

                        <Button
                            x:Name="HistoryButton"
                            Grid.Column="1"
                            Text="История"
                            Clicked="GoHistory"
                            BackgroundColor="Transparent"
                            TextColor="#172033"
                            CornerRadius="12"
                            Padding="8,8"
                            FontSize="14"
                            MinimumHeightRequest="36" />

                        <Button
                            x:Name="CathetersButton"
                            Grid.Column="2"
                            Text="Катетри"
                            Clicked="GoCatheters"
                            BackgroundColor="Transparent"
                            TextColor="#172033"
                            CornerRadius="12"
                            Padding="8,8"
                            FontSize="14"
                            MinimumHeightRequest="36" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>
