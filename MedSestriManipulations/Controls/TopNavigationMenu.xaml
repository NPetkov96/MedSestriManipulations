<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MedSestriManipulations.Controls.TopNavigationMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Loaded="OnLoaded">

    <Grid BackgroundColor="{StaticResource WarmSurface}" RowDefinitions="Auto,Auto,Auto">

        <Grid Grid.Row="0" Padding="18,14,18,9">
            <Label
                Text="Медицински Сестри"
                Style="{StaticResource WarmPageTitle}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1"
                                Spacing="28"
                                HorizontalOptions="Center">

            <Grid MinimumHeightRequest="48" MinimumWidthRequest="48">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoHome" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label x:Name="HomeTabLabel"
                           Text="Начало"
                           Style="{StaticResource WarmButtonText}"
                           HorizontalOptions="Center" />
                    <BoxView x:Name="HomeUnderline"
                             HeightRequest="2"
                             WidthRequest="36"
                             Color="{StaticResource WarmAccent}"
                             IsVisible="False"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid MinimumHeightRequest="48" MinimumWidthRequest="48">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoHistory" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label x:Name="HistoryTabLabel"
                           Text="История"
                           Style="{StaticResource WarmButtonText}"
                           HorizontalOptions="Center" />
                    <BoxView x:Name="HistoryUnderline"
                             HeightRequest="2"
                             WidthRequest="36"
                             Color="{StaticResource WarmAccent}"
                             IsVisible="False"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid MinimumHeightRequest="48" MinimumWidthRequest="48">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoCatheters" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label x:Name="CathetersTabLabel"
                           Text="Катетри"
                           Style="{StaticResource WarmButtonText}"
                           HorizontalOptions="Center" />
                    <BoxView x:Name="CathetersUnderline"
                             HeightRequest="2"
                             WidthRequest="36"
                             Color="{StaticResource WarmAccent}"
                             IsVisible="False"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </HorizontalStackLayout>

        <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource WarmDivider}" />
    </Grid>
</ContentView>
