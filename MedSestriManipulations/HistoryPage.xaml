<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             xmlns:helpers="clr-namespace:MedSestriManipulations.Helpers"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             x:Class="MedSestriManipulations.HistoryPage"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <DataTemplate x:Key="HistoryWeekHeaderTemplate" x:DataType="models:HistoryListItem">
            <Grid BackgroundColor="#F9FAFB"
                  HorizontalOptions="Center"
                  Padding="0,16,0,5">
                <Label Text="{Binding HeaderText}"
                       TextColor="#9CA3AF"
                       FontSize="13"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryPatientTemplate" x:DataType="models:HistoryListItem">
            <Border Margin="0,0,0,5"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Stroke="#F3F4F6"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="12">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPatientTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding Patient.FullName}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="#111827" LineBreakMode="WordWrap" />

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Patient.EGN}" FontSize="12" TextColor="#3B82F6" />
                            <Label Text="·" FontSize="10" TextColor="#9CA3AF" />
                            <Label Text="{Binding Patient.ShortDateText}" FontSize="10" TextColor="#9CA3AF" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                         HorizontalOptions="End" Spacing="2">
                        <Label Text="{Binding Patient.TotalEuro, StringFormat='{0:F2} €'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F766E"
                               HorizontalOptions="End" />
                        <Label Text="{Binding Patient.TestsCountText}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#3B82F6"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <helpers:HistoryListItemTemplateSelector x:Key="HistoryListItemTemplateSelector"
                                                 HeaderTemplate="{StaticResource HistoryWeekHeaderTemplate}"
                                                 PatientTemplate="{StaticResource HistoryPatientTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        
        <controls:TopNavigationMenu Grid.Row="0" />

        
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,8" Spacing="10" BackgroundColor="#F8F9FB">

            <Border Stroke="#D4DDE8" StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 8"
                    Padding="6,0">
                <SearchBar x:Name="SearchBar"
                           Placeholder="Търси история на пациенти..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           FontSize="16" HeightRequest="48"
                           CancelButtonColor="#0066CC"
                           TextColor="#1A1A1A"
                           PlaceholderColor="#999999" />
            </Border>
        </VerticalStackLayout>

        
        <CollectionView Grid.Row="2"
                        x:Name="PatientsCollection"
                        SelectionMode="None"
                        Margin="16,4,16,0"
                        IsVisible="False"
                        RemainingItemsThreshold="8"
                        RemainingItemsThresholdReached="PatientsCollection_RemainingItemsThresholdReached"
                        ItemTemplate="{StaticResource HistoryListItemTemplateSelector}">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="32,60" Spacing="10">
                    <Label Text="🗂"
                           FontSize="44"
                           HorizontalOptions="Center"
                           Opacity="0.4" />
                    <Label Text="Няма намерени пациенти"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#666666"
                           HorizontalOptions="Center" />
                    <Label Text="Изпратените пациенти ще се показват тук"
                           FontSize="13"
                           TextColor="#AAAAAA"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <controls:SkeletonListView x:Name="PatientsSkeleton"
                                   Grid.Row="2" />

        
        <Grid x:Name="SheetOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#70000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        
        <Border x:Name="SheetPanel"
                Grid.RowSpan="3"
                VerticalOptions="End"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20,20,0,0">
            <VerticalStackLayout Spacing="14" Padding="20,12,20,32">

                
                <BoxView WidthRequest="40" HeightRequest="4"
                         BackgroundColor="#D4DDE8"
                         HorizontalOptions="Center"
                         CornerRadius="2" />

                <Label x:Name="SheetNameLabel"
                       HorizontalOptions="Center"
                       Text=""
                       FontSize="24" FontAttributes="Bold"
                       TextColor="#1A1A1A" />

                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label x:Name="SheetEgnLabel" Text="" FontSize="18" TextColor="#666666" />
                    <Label Text="·" FontSize="22" TextColor="#999999" />
                    <Label x:Name="SheetPhoneLabel" Text="" FontSize="18" TextColor="#666666" />
                </HorizontalStackLayout>

                <Label x:Name="SheetDateLabel" Text="" FontSize="16" TextColor="#999999" HorizontalOptions="Center"/>

                
                <Border Stroke="#D4DDE8" StrokeThickness="1"
                        BackgroundColor="#F8F9FB"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <ScrollView MaximumHeightRequest="220" Padding="12,10">
                        <Label x:Name="SheetNoteLabel"
                               Text=""
                               FontSize="14"
                               TextColor="#444444" />
                    </ScrollView>
                </Border>

                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Копирай"
                            Clicked="OnCopyClicked"
                            BackgroundColor="#E8EEF5"
                            TextColor="#0066CC"
                            BorderColor="#0066CC"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="14" />
                    <Button Grid.Column="1"
                            Text="Използвай"
                            Clicked="OnReuseClicked"
                            BackgroundColor="#0066CC"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="14" />
                </Grid>

                <Button Text="Изтрий пациента"
                        Clicked="OnDeleteClicked"
                        BackgroundColor="Transparent"
                        TextColor="#C62828"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="44" />
            </VerticalStackLayout>
        </Border>

        
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="False">
            <ActivityIndicator IsRunning="True" IsVisible="True"
                               WidthRequest="55" HeightRequest="55" Color="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
