<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             x:Class="MedSestriManipulations.HistoryPage"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Top Navigation -->
        <controls:TopNavigationMenu Grid.Row="0" />

        <!-- Row 1: Header + search (matches MainPage) -->
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,8" Spacing="10" BackgroundColor="#F8F9FB">

            <Border Stroke="#D4DDE8" StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 8"
                    Padding="6,0">
                <SearchBar x:Name="SearchBar"
                           Placeholder="Търси история на пациенти..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           FontSize="16" HeightRequest="48"
                           CancelButtonColor="#0066CC"
                           TextColor="#1A1A1A"
                           PlaceholderColor="#999999" />
            </Border>
        </VerticalStackLayout>

        <!-- Row 2: Patients list -->
        <CollectionView Grid.Row="2"
                        x:Name="PatientsCollection"
                        SelectionMode="None"
                        Margin="16,4,16,0"
                        IsVisible="False"
                        IsGrouped="True">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid BackgroundColor="#F9FAFB" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                        </Grid.GestureRecognizers>

                        <Label Text="{Binding Key}"
                               TextColor="#9CA3AF"
                               FontSize="12"
                               Padding="16,12,4,4"
                               VerticalOptions="Center" />

                        <!-- Chevron indicating expanded/collapsed state -->
                        <Label Grid.Column="1"
                               x:Name="Chevron"
                               Text="▾"
                               TextColor="#9CA3AF"
                               FontSize="12"
                               Padding="8,12,12,4"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Text" Value="▸" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Text" Value="▾" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Patient">
                    <Border Margin="0,0,0,6"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White"
                            Stroke="#F3F4F6"
                            StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="12">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPatientTapped" />
                            </Grid.GestureRecognizers>

                            <!-- Left: patient info -->
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding FullName}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#111827" LineBreakMode="WordWrap" />

                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding PhoneFormatted}" FontSize="11" TextColor="#6B7280" />
                                    <Label Text="·" FontSize="10" TextColor="#9CA3AF" />
                                    <Label Text="{Binding ShortDateText}" FontSize="10" TextColor="#9CA3AF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Right: price badge + test count badge -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                                 HorizontalOptions="End" Spacing="4">

                                <!-- Price badge: amber when zero, teal otherwise -->
                                <Border StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                        Padding="8,3" HorizontalOptions="End"
                                        BackgroundColor="#F0FDF9">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsZeroPrice}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding TotalEuro, StringFormat='{0:F2} €'}"
                                           FontSize="12" FontAttributes="Bold" TextColor="#0F766E">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsZeroPrice}" Value="True">
                                                <Setter Property="TextColor" Value="#92400E" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <!-- Test count badge -->
                                <Border BackgroundColor="#EFF6FF" StrokeShape="RoundRectangle 6"
                                        Stroke="Transparent" Padding="8,2" HorizontalOptions="End">
                                    <Label Text="{Binding TestsCountText}"
                                           FontSize="10" FontAttributes="Bold" TextColor="#3B82F6" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="32,60" Spacing="10">
                    <Label Text="🗂"
                           FontSize="44"
                           HorizontalOptions="Center"
                           Opacity="0.4" />
                    <Label Text="Няма намерени пациенти"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#666666"
                           HorizontalOptions="Center" />
                    <Label Text="Изпратените пациенти ще се показват тук"
                           FontSize="13"
                           TextColor="#AAAAAA"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <controls:SkeletonListView x:Name="PatientsSkeleton"
                                   Grid.Row="2" />

        <!-- Bottom sheet dim overlay -->
        <Grid x:Name="SheetOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#70000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Bottom sheet panel: patient details + actions -->
        <Border x:Name="SheetPanel"
                Grid.RowSpan="3"
                VerticalOptions="End"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20,20,0,0">
            <VerticalStackLayout Spacing="14" Padding="20,12,20,32">

                <!-- Drag handle -->
                <BoxView WidthRequest="40" HeightRequest="4"
                         BackgroundColor="#D4DDE8"
                         HorizontalOptions="Center"
                         CornerRadius="2" />

                <Label x:Name="SheetNameLabel"
                       HorizontalOptions="Center"
                       Text=""
                       FontSize="24" FontAttributes="Bold"
                       TextColor="#1A1A1A" />

                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label x:Name="SheetEgnLabel" Text="" FontSize="18" TextColor="#666666" />
                    <Label Text="·" FontSize="22" TextColor="#999999" />
                    <Label x:Name="SheetPhoneLabel" Text="" FontSize="18" TextColor="#666666" />
                </HorizontalStackLayout>

                <Label x:Name="SheetDateLabel" Text="" FontSize="16" TextColor="#999999" HorizontalOptions="Center"/>

                <!-- Note / message -->
                <Border Stroke="#D4DDE8" StrokeThickness="1"
                        BackgroundColor="#F8F9FB"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <ScrollView MaximumHeightRequest="220" Padding="12,10">
                        <Label x:Name="SheetNoteLabel"
                               Text=""
                               FontSize="14"
                               TextColor="#444444" />
                    </ScrollView>
                </Border>

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Копирай"
                            Clicked="OnCopyClicked"
                            BackgroundColor="#E8EEF5"
                            TextColor="#0066CC"
                            BorderColor="#0066CC"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="14" />
                    <Button Grid.Column="1"
                            Text="Използвай"
                            Clicked="OnReuseClicked"
                            BackgroundColor="#0066CC"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="14" />
                </Grid>

                <Button Text="Изтрий пациента"
                        Clicked="OnDeleteClicked"
                        BackgroundColor="Transparent"
                        TextColor="#C62828"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="44" />
            </VerticalStackLayout>
        </Border>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="False">
            <ActivityIndicator IsRunning="True" IsVisible="True"
                               WidthRequest="55" HeightRequest="55" Color="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
