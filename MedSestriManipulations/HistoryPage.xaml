<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             xmlns:helpers="clr-namespace:MedSestriManipulations.Helpers"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             x:Class="MedSestriManipulations.HistoryPage"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <DataTemplate x:Key="HistoryWeekHeaderTemplate" x:DataType="models:HistoryListItem">
            <Grid BackgroundColor="#F9FAFB"
                  HorizontalOptions="Center"
                  Padding="0,16,0,5">
                <Label Text="{Binding HeaderText}"
                       TextColor="#9CA3AF"
                       FontSize="13"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryPatientTemplate" x:DataType="models:HistoryListItem">
            <Border Margin="0,0,0,5"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    Stroke="#F3F4F6"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="12">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPatientTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding Patient.FullName}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="#111827" LineBreakMode="WordWrap" />

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Patient.EGN}" FontSize="12" TextColor="#3B82F6" />
                            <Label Text="·" FontSize="10" TextColor="#9CA3AF" />
                            <Label Text="{Binding Patient.ShortDateText}" FontSize="10" TextColor="#9CA3AF" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                         HorizontalOptions="End" Spacing="2">
                        <Label Text="{Binding Patient.TotalEuro, StringFormat='{0:F2} €'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F766E"
                               HorizontalOptions="End" />
                        <Label Text="{Binding Patient.TestsCountText}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#3B82F6"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <helpers:HistoryListItemTemplateSelector x:Key="HistoryListItemTemplateSelector"
                                                 HeaderTemplate="{StaticResource HistoryWeekHeaderTemplate}"
                                                 PatientTemplate="{StaticResource HistoryPatientTemplate}" />

        <DataTemplate x:Key="SheetProcedureTemplate" x:DataType="models:PatientProcedureRow">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="28,*,Auto" Padding="0,10" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding Number, StringFormat='{0}.'}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#3B82F6"
                           VerticalOptions="Start"
                           HorizontalTextAlignment="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding Name}"
                           FontSize="14"
                           TextColor="#111827"
                           LineBreakMode="WordWrap"
                           LineHeight="1.12" />
                    <Label Grid.Column="2"
                           Text="{Binding EuroPrice, StringFormat='{0:F2} €'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#0F766E"
                           VerticalOptions="Start"
                           HorizontalOptions="End" />
                </Grid>
                <BoxView HeightRequest="1"
                         Color="#EEF2F7"
                         IsVisible="{Binding HasDivider}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        
        <controls:TopNavigationMenu Grid.Row="0" />

        
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,8" Spacing="10" BackgroundColor="#F8F9FB">

            <Border Stroke="#D4DDE8" StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 8"
                    Padding="6,0">
                <SearchBar x:Name="SearchBar"
                           Placeholder="Търси история на пациенти..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           FontSize="16" HeightRequest="48"
                           CancelButtonColor="#0066CC"
                           TextColor="#1A1A1A"
                           PlaceholderColor="#999999" />
            </Border>
        </VerticalStackLayout>

        
        <CollectionView Grid.Row="2"
                        x:Name="PatientsCollection"
                        SelectionMode="None"
                        Margin="16,4,16,0"
                        IsVisible="False"
                        RemainingItemsThreshold="8"
                        RemainingItemsThresholdReached="PatientsCollection_RemainingItemsThresholdReached"
                        ItemTemplate="{StaticResource HistoryListItemTemplateSelector}">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="32,60" Spacing="10">
                    <Label Text="🗂"
                           FontSize="44"
                           HorizontalOptions="Center"
                           Opacity="0.4" />
                    <Label Text="Няма намерени пациенти"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#666666"
                           HorizontalOptions="Center" />
                    <Label Text="Изпратените пациенти ще се показват тук"
                           FontSize="13"
                           TextColor="#AAAAAA"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <controls:SkeletonListView x:Name="PatientsSkeleton"
                                   Grid.Row="2" />

        
        <Grid x:Name="SheetOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#70000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        
        <Border x:Name="SheetPanel"
                Grid.RowSpan="3"
                VerticalOptions="End"
                IsVisible="False"
                BackgroundColor="#F8FAFC"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20,20,0,0">
            <Border.Shadow>
                <Shadow Brush="#334155" Offset="0,-6" Radius="18" Opacity="0.14" />
            </Border.Shadow>
            <ScrollView x:Name="SheetScrollView"
                        MaximumHeightRequest="760">
                <VerticalStackLayout Spacing="16" Padding="20,12,20,30">
                    <Grid ColumnDefinitions="44,*,44" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
                            <SwipeGestureRecognizer Direction="Down" Swiped="OnSheetSwipeDown" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="1"
                                 WidthRequest="70"
                                 HeightRequest="4"
                                 BackgroundColor="#CBD5E1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 CornerRadius="2" />
                        <Button Grid.Column="2"
                                Text="×"
                                Clicked="OnSheetCloseClicked"
                                BackgroundColor="#EEF2F7"
                                TextColor="#64748B"
                                FontSize="22"
                                FontAttributes="Bold"
                                Padding="0"
                                CornerRadius="18"
                                WidthRequest="36"
                                HeightRequest="36"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Fill">
                        <Border WidthRequest="64"
                                HeightRequest="64"
                                BackgroundColor="#E8F3FF"
                                Stroke="#C7E0FF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 32"
                                HorizontalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="#3B82F6" Offset="0,4" Radius="12" Opacity="0.12" />
                            </Border.Shadow>
                            <Label Text="☤"
                                   FontSize="30"
                                   TextColor="#0F766E"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label x:Name="SheetNameLabel"
                               HorizontalOptions="Center"
                               Text=""
                               FontSize="23"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,8">
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="№" FontSize="13" FontAttributes="Bold" TextColor="#3B82F6" VerticalOptions="Center" />
                                    <Label x:Name="SheetEgnLabel" Text="" FontSize="14" FontAttributes="Bold" TextColor="#475569" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="1"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,8">
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="☎" FontSize="13" TextColor="#0F766E" VerticalOptions="Center" />
                                    <Label x:Name="SheetPhoneLabel" Text="" FontSize="14" FontAttributes="Bold" TextColor="#475569" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border BackgroundColor="#EEF6FF" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="10,7">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="□" FontSize="13" TextColor="#3B82F6" VerticalOptions="Center" />
                                    <Label x:Name="SheetDateOnlyLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border BackgroundColor="#F0FDFA" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="10,7">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="◷" FontSize="14" TextColor="#0F766E" VerticalOptions="Center" />
                                    <Label x:Name="SheetTimeLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#94A3B8" Offset="0,6" Radius="16" Opacity="0.10" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Информация за пациента"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="14">
                                <Label Grid.Row="0" Grid.Column="0" Text="Пациент" FontSize="12" TextColor="#94A3B8" />
                                <Label Grid.Row="0" Grid.Column="1" x:Name="SheetInfoNameLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#334155" HorizontalTextAlignment="End" />
                                <Label Grid.Row="1" Grid.Column="0" Text="ЕГН" FontSize="12" TextColor="#94A3B8" />
                                <Label Grid.Row="1" Grid.Column="1" x:Name="SheetInfoEgnLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#334155" HorizontalTextAlignment="End" />
                                <Label Grid.Row="2" Grid.Column="0" Text="Телефон" FontSize="12" TextColor="#94A3B8" />
                                <Label Grid.Row="2" Grid.Column="1" x:Name="SheetInfoPhoneLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#334155" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#94A3B8" Offset="0,6" Radius="16" Opacity="0.10" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Избрани манипулации"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label Grid.Column="1"
                                       x:Name="SheetTestsCountLabel"
                                       Text=""
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#3B82F6"
                                       VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout x:Name="SheetTestsLayout"
                                                 Spacing="0"
                                                 BindableLayout.ItemTemplate="{StaticResource SheetProcedureTemplate}" />

                            <Border BackgroundColor="#EAF4FF"
                                    Stroke="#C7E0FF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12"
                                    Margin="0,4,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="Общо"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Grid.Column="1"
                                           x:Name="SheetTotalLabel"
                                           Text=""
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F766E" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Копирай"
                                Clicked="OnCopyClicked"
                                BackgroundColor="White"
                                TextColor="#0066CC"
                                BorderColor="#0066CC"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                FontSize="14" />
                        <Button Grid.Column="1"
                                Text="Използвай"
                                Clicked="OnReuseClicked"
                                BackgroundColor="#0066CC"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                FontSize="14" />
                    </Grid>

                    <Button Text="🗑 Изтрий пациента"
                            Clicked="OnDeleteClicked"
                            BackgroundColor="Transparent"
                            TextColor="#DC2626"
                            FontSize="14"
                            FontAttributes="Bold"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="False">
            <ActivityIndicator IsRunning="True" IsVisible="True"
                               WidthRequest="55" HeightRequest="55" Color="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
