<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MedSestriManipulations"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#dfe9f5"
             x:Class="MedSestriManipulations.HistoryPage">

    <Grid RowDefinitions="Auto,*">
        <controls:TopNavigationMenu Grid.Row="0" />

        <CollectionView x:Name="HistoryList" Grid.Row="1" SelectionMode="None" BackgroundColor="#dfe9f5">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Padding="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" x:Name="SearchGrid">
                        <toolkit:Expander x:Name="ExpanderEGN" Grid.Column="1" IsExpanded="True">
                            <VerticalStackLayout Padding="10">
                                <Entry x:Name="InputEntry" Placeholder="Търси пациент" FontSize="15" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                                    <Button Grid.Column="0" Text="Търси" FontSize="12" BackgroundColor="#007ACC" TextColor="White" Clicked="SearchText" />
                                    <Button Grid.Column="1" Text="Зачисти" FontSize="10" BackgroundColor="DarkRed" TextColor="White" Clicked="ClearSearchBar" />
                                </Grid>
                            </VerticalStackLayout>
                        </toolkit:Expander>
                    </Grid>

                    <Border x:Name="SelectedPatientCard" Margin="10" Padding="15" BackgroundColor="#f0f4f8" Stroke="#D0DCEB" StrokeShape="RoundRectangle 15">
                        <VerticalStackLayout>
                            <Label x:Name="FullNameLabel" Text="{Binding SelectedPatient.FullName}" FontAttributes="Bold" FontSize="20" TextColor="Black" />
                            <Label x:Name="DateLabel" Text="{Binding SelectedPatient.Date}" FontAttributes="Bold" FontSize="16" TextColor="Gray" />
                            <Label x:Name="NoteLabel" Text="{Binding SelectedPatient.Note}" FontSize="14" TextColor="Gray" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
                                <Button Grid.Column="0" Text="Изтрий" FontSize="12" BackgroundColor="DarkRed" TextColor="White" Clicked="Delete" />
                                <Button Grid.Column="1" Text="Копирай" FontSize="10" BackgroundColor="White" TextColor="Black" Clicked="Coppy" />
                                <Button Grid.Column="2" Text="Използвай" FontSize="10" BackgroundColor="DarkSeaGreen" TextColor="Black" Clicked="ReUsePatient" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Patient">
                    <Border Stroke="#dfe9f5" StrokeShape="RoundRectangle 20" Padding="7" Margin="5" BackgroundColor="#cbdbeb">
                        <VerticalStackLayout Margin="5,0">
                            <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="16" TextColor="DarkBlue">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:HistoryPage}}, Path=BindingContext.UpdateCard}" CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Text="{Binding Date}" FontSize="14" TextColor="Gray">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:HistoryPage}}, Path=BindingContext.UpdateCard}" CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="LoadingIndicator" Grid.RowSpan="2" IsRunning="False" IsVisible="False" Color="DarkBlue" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50" />
    </Grid>
</ContentPage>
