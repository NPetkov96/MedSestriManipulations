<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MedSestriManipulations.Models"
             xmlns:controls="clr-namespace:MedSestriManipulations.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="MedSestriManipulations.HistoryPage"
             BackgroundColor="{StaticResource WarmBg}">

    <Grid RowDefinitions="Auto,Auto,*">

        <controls:TopNavigationMenu Grid.Row="0" />

        <!-- Sticky search field - same pattern as Начало -->
        <Border Grid.Row="1"
                Style="{StaticResource WarmFieldBorder}"
                Margin="18,9,18,9"
                Padding="14,0">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">

                <Grid Grid.Column="0" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                    <shapes:Ellipse WidthRequest="11" HeightRequest="11"
                                    Stroke="{StaticResource WarmNeutral500}"
                                    StrokeThickness="1.5"
                                    HorizontalOptions="Start" VerticalOptions="Start" />
                    <shapes:Line X1="8" Y1="8" X2="15" Y2="15"
                                 Stroke="{StaticResource WarmNeutral500}"
                                 StrokeThickness="1.5" />
                </Grid>

                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Style="{StaticResource WarmEntry}"
                       Placeholder="Търси история на пациенти…"
                       ReturnType="Search"
                       TextChanged="OnSearchTextChanged"
                       VerticalOptions="Center" />

                <Button Grid.Column="2"
                        x:Name="SearchClearButton"
                        Text="×"
                        FontSize="20"
                        Style="{StaticResource WarmGhostButton}"
                        IsVisible="False"
                        Clicked="OnSearchClearClicked"
                        SemanticProperties.Description="Изчисти търсенето" />
            </Grid>
        </Border>

        <!-- Grouped visit list -->
        <CollectionView x:Name="PatientsCollection"
                        Grid.Row="2"
                        IsGrouped="True"
                        SelectionMode="None"
                        Margin="18,0,18,0"
                        IsVisible="False">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:VisitWeekGroup">
                    <Grid HorizontalOptions="Center" Padding="0,18,0,9">
                        <Label Text="{Binding WeekRangeLabel}"
                               Style="{StaticResource WarmCaption}"
                               FontFamily="OpenSansRegular" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Patient">
                    <Border Stroke="Transparent" BackgroundColor="Transparent" Padding="0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource WarmSurface}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>

                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  Padding="4,12"
                                  MinimumHeightRequest="48">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPatientTapped" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding FullName}"
                                           FontFamily="{StaticResource WarmHeadingFont}"
                                           FontSize="16"
                                           TextColor="{StaticResource WarmText}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding HistoryRowMetaText}"
                                           FontFamily="OpenSansRegular"
                                           FontSize="12"
                                           TextColor="{StaticResource WarmTextMuted}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding TotalEuro, StringFormat='{0:F2} €'}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14"
                                           TextColor="{StaticResource WarmAccent700}"
                                           HorizontalOptions="End" />
                                    <Label FormattedText="{Binding TestsCountFormatted}"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource WarmDivider}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="37,74" Spacing="14">
                    <Grid WidthRequest="40" HeightRequest="40" HorizontalOptions="Center">
                        <shapes:Ellipse WidthRequest="26" HeightRequest="26"
                                        Stroke="{StaticResource WarmNeutral400}"
                                        StrokeThickness="2"
                                        HorizontalOptions="Start" VerticalOptions="Start" />
                        <shapes:Line X1="22" Y1="22" X2="34" Y2="34"
                                     Stroke="{StaticResource WarmNeutral400}"
                                     StrokeThickness="2" />
                    </Grid>
                    <Label Text="Нищо не намерихме"
                           Style="{StaticResource WarmSectionHeading}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Опитайте с друга дума или проверете изписването."
                           Style="{StaticResource WarmCaption}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Изчисти търсенето"
                            Style="{StaticResource WarmSecondaryButton}"
                            Clicked="OnClearSearchClicked" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <controls:SkeletonListView x:Name="PatientsSkeleton"
                                   SkeletonType="Patient"
                                   Grid.Row="2" />

        <!-- Detail sheet backdrop -->
        <Grid x:Name="SheetOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Detail sheet -->
        <Border x:Name="SheetPanel"
                Grid.RowSpan="3"
                VerticalOptions="End"
                IsVisible="False"
                BackgroundColor="{StaticResource WarmBg}"
                Stroke="Transparent"
                Padding="0">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource WarmText}" Offset="0,-6" Radius="18" Opacity="0.14" />
            </Border.Shadow>
            <ScrollView x:Name="SheetScrollView" MaximumHeightRequest="760">
                <VerticalStackLayout Spacing="18" Padding="20,12,20,30">

                    <Grid ColumnDefinitions="44,*,44" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
                            <SwipeGestureRecognizer Direction="Down" Swiped="OnSheetSwipeDown" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="1"
                                 WidthRequest="70"
                                 HeightRequest="4"
                                 BackgroundColor="{StaticResource WarmNeutral400}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 CornerRadius="2" />
                        <Border Grid.Column="2"
                                MinimumWidthRequest="44" MinimumHeightRequest="44"
                                BackgroundColor="{StaticResource WarmSurface}"
                                Stroke="Transparent"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Затвори">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSheetCloseClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="×"
                                   FontSize="22"
                                   TextColor="{StaticResource WarmText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Fill">
                        <Border WidthRequest="64" HeightRequest="64"
                                BackgroundColor="{StaticResource WarmAccent100}"
                                Stroke="{StaticResource WarmAccent}"
                                StrokeThickness="1"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Grid>
                                <shapes:Ellipse Fill="{StaticResource WarmAccent700}"
                                                WidthRequest="20" HeightRequest="20"
                                                HorizontalOptions="Center" VerticalOptions="Start"
                                                Margin="0,14,0,0" />
                                <shapes:Ellipse Fill="{StaticResource WarmAccent700}"
                                                WidthRequest="42" HeightRequest="40"
                                                HorizontalOptions="Center" VerticalOptions="End"
                                                Margin="0,0,0,-16" />
                            </Grid>
                        </Border>

                        <Label x:Name="SheetNameLabel"
                               HorizontalOptions="Center"
                               Style="{StaticResource WarmPageTitle}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource WarmCard}" Padding="10,8">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Label x:Name="SheetEgnLabel"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{StaticResource WarmText}"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource WarmCard}" Padding="10,8">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Grid WidthRequest="10" HeightRequest="14" VerticalOptions="Center">
                                        <shapes:RoundRectangle Stroke="{StaticResource WarmTextMuted}"
                                                                StrokeThickness="1.3"
                                                                Fill="Transparent"
                                                                CornerRadius="2" />
                                    </Grid>
                                    <Label x:Name="SheetPhoneLabel"
                                           FontFamily="OpenSansRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource WarmText}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border Style="{StaticResource WarmCard}" Padding="10,7">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Grid WidthRequest="13" HeightRequest="12" VerticalOptions="Center">
                                        <shapes:RoundRectangle Stroke="{StaticResource WarmTextMuted}"
                                                                StrokeThickness="1.2"
                                                                Fill="Transparent"
                                                                CornerRadius="2" />
                                        <shapes:Line X1="1" Y1="4" X2="12" Y2="4"
                                                     Stroke="{StaticResource WarmTextMuted}"
                                                     StrokeThickness="1.2" />
                                    </Grid>
                                    <Label x:Name="SheetDateOnlyLabel"
                                           FontFamily="OpenSansRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource WarmText}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Style="{StaticResource WarmCard}" Padding="10,7">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Grid WidthRequest="13" HeightRequest="13" VerticalOptions="Center">
                                        <shapes:Ellipse Stroke="{StaticResource WarmTextMuted}"
                                                        StrokeThickness="1.2"
                                                        Fill="Transparent" />
                                        <shapes:Line X1="6.5" Y1="6.5" X2="6.5" Y2="2.5"
                                                     Stroke="{StaticResource WarmTextMuted}"
                                                     StrokeThickness="1.2" />
                                        <shapes:Line X1="6.5" Y1="6.5" X2="9.5" Y2="6.5"
                                                     Stroke="{StaticResource WarmTextMuted}"
                                                     StrokeThickness="1.2" />
                                    </Grid>
                                    <Label x:Name="SheetTimeLabel"
                                           FontFamily="OpenSansRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource WarmText}" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource WarmCard}" Padding="16">
                        <Border.StrokeShape>
                            <shapes:RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Информация за пациента" Style="{StaticResource WarmSectionHeading}" />
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="14">
                                <Label Grid.Row="0" Grid.Column="0" Text="Пациент" Style="{StaticResource WarmCaption}" />
                                <Label Grid.Row="0" Grid.Column="1" x:Name="SheetInfoNameLabel"
                                       Style="{StaticResource WarmBody}" HorizontalTextAlignment="End" />
                                <Label Grid.Row="1" Grid.Column="0" Text="ЕГН" Style="{StaticResource WarmCaption}" />
                                <Label Grid.Row="1" Grid.Column="1" x:Name="SheetInfoEgnLabel"
                                       FontFamily="OpenSansRegular" FontSize="15" TextColor="{StaticResource WarmText}"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Row="2" Grid.Column="0" Text="Телефон" Style="{StaticResource WarmCaption}" />
                                <Label Grid.Row="2" Grid.Column="1" x:Name="SheetInfoPhoneLabel"
                                       FontFamily="OpenSansRegular" FontSize="15" TextColor="{StaticResource WarmText}"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource WarmCard}" Padding="16">
                        <Border.StrokeShape>
                            <shapes:RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Избрани манипулации" Style="{StaticResource WarmSectionHeading}" />
                                <Label Grid.Column="1" x:Name="SheetTestsCountLabel" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout x:Name="SheetTestsLayout" Spacing="0" />

                            <BoxView HeightRequest="1" Color="{StaticResource WarmDivider}" Margin="0,4" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Общо" Style="{StaticResource WarmBody}" VerticalOptions="Center" />
                                <Label Grid.Column="1" x:Name="SheetTotalLabel" Style="{StaticResource WarmPriceEmphasis}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>
